# ─────────────────────────────────────────────────────────────
# MR GROW — Variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME="MR Grow"
NEXT_PUBLIC_WHATSAPP=5500000000000
NEXT_PUBLIC_INSTAGRAM=https://www.instagram.com/mrgrow.ag/

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente server-side. NUNCA exponha com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Tracking / Analytics ─────────────────────────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API (server-side, deduplicado com o Pixel via event_id)
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=

# ── Meta (Facebook/Instagram) Marketing API ──────────────────
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/integracoes/meta/callback

# ── Google (Ads + Analytics 4) ───────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integracoes/google/callback
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ── Segurança / Jobs ─────────────────────────────────────────
# Chave AES-256 (32 bytes em base64) usada para cifrar tokens OAuth no banco.
# Gere com: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Protege as rotas /api/cron/*
CRON_SECRET=

# ── Integrações opcionais ────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM="MR Grow <contato@mrgrow.com.br>"
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SLACK_WEBHOOK_URL=
ASAAS_API_KEY=
